# =====================================================================
# Suricata Threshold & Suppression Configuration
# =====================================================================
# Install to /etc/suricata/threshold.config
#
# Thresholds live here rather than inline in the rules so that tuning a
# noisy signature does not require editing detection logic. A rule file
# and a tuning file change for different reasons and on different
# schedules; keeping them separate means a threshold change never risks
# breaking a match condition.
#
# Rationale for each value is in docs/tuning-guide.md.
# =====================================================================


# ---------------------------------------------------------------------
# RATE-BASED DETECTION
# ---------------------------------------------------------------------

# SID 1000004 — SSH brute force. 5 attempts in 60s from one source.
# Rationale: a human mistyping a password produces 2-3 attempts. Automated
# guessing produces dozens. Five is above human error, below the point
# where an attacker has made meaningful progress.
threshold gen_id 1, sig_id 1000004, type both, track by_src, count 5, seconds 60

# SID 1000012 — HTTP Basic Auth brute force. Higher count than SSH because
# some clients retry auth automatically on page load.
threshold gen_id 1, sig_id 1000012, type both, track by_src, count 10, seconds 60

# SID 1000013 — Excessive 404s. Tracked by_dst so the counter follows the
# external scanner rather than the local web server.
threshold gen_id 1, sig_id 1000013, type both, track by_dst, count 20, seconds 60

# SID 1000203 — Sustained high-entropy DNS. 40 in 300s converts a
# per-query heuristic into a channel-level verdict.
threshold gen_id 1, sig_id 1000203, type both, track by_src, count 40, seconds 300


# ---------------------------------------------------------------------
# NOISE LIMITING
# ---------------------------------------------------------------------

# SID 1000201 — High-entropy DNS (single query). Limit to 1 alert per
# source per minute. Without this a single tunneling session generates
# hundreds of near-identical alerts and buries everything else.
threshold gen_id 1, sig_id 1000201, type limit, track by_src, count 1, seconds 60

# SID 1000102 — JA4 not on the PQ allowlist. Limit per source; a single
# non-compliant client would otherwise alert on every connection it makes.
threshold gen_id 1, sig_id 1000102, type limit, track by_src, count 1, seconds 300

# SID 1000103 — SNI-absent TLS. Informational severity, heavily rate-limited.
threshold gen_id 1, sig_id 1000103, type limit, track by_src, count 1, seconds 600


# ---------------------------------------------------------------------
# SUPPRESSIONS — environment-specific, examples only
# ---------------------------------------------------------------------
# Uncomment and adapt. Each suppression should be justified in a comment;
# an undocumented suppression is indistinguishable from a blind spot.

# Vulnerability scanner authorised to scan the DMZ — suppress scanner-UA
# alerts from it only, not globally.
# suppress gen_id 1, sig_id 1000005, track by_src, ip 10.20.30.40

# Mail relay performs high volumes of DKIM/DMARC TXT lookups that resemble
# tunneling. Suppress the TXT-entropy rule for this host only.
# suppress gen_id 1, sig_id 1000202, track by_src, ip 10.20.30.25

# Build server legitimately pulls artifacts from raw-IP hosts.
# suppress gen_id 1, sig_id 1000016, track by_src, ip 10.20.30.60
